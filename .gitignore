# ============================================================
# qingflow-to-yida-migrator - 开源发布排除规则
# 原则：本地保留全部真实数据与配置，仓库只推代码与示例文件
# ============================================================

# ---- 运行产物与业务数据（本地保留，不入库）----
data/
*.log

# ---- 真实密钥与配置（本地保留，不入库）----
config/credentials.json
config/settings.json
config/表单对照表.csv
config/forms/*.json
!config/forms/示例表单.json

# ---- 真实字段映射表（本地保留，不入库）----
mappings/*.csv
!mappings/*.example.csv

# ---- 内部文档与旧版归档（含真实业务信息，本地保留）----
WORK_SUMMARY_*.md
archive/

# ---- 内部测试脚本（含真实字段 ID，本地保留）----
scripts/_test_attachment_autofetch.py

# ---- Python ----
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/

# ---- 编辑器 / 系统 ----
.idea/
.vscode/
*.swp
.DS_Store
Thumbs.db
docs/COMPLIANCE.md
